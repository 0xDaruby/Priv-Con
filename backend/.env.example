# Controlled local temporary directories
UPLOAD_TEMP_DIR=./temp/uploads
OUTPUT_TEMP_DIR=./temp/outputs

# Request, output, and concurrency limits
MAX_UPLOAD_SIZE_MB=50
MAX_TOTAL_UPLOAD_SIZE_MB=200
MAX_REQUEST_SIZE_MB=205
MAX_OUTPUT_SIZE_MB=500
MAX_FILES_PER_REQUEST=20
MAX_FORM_FIELDS_PER_REQUEST=10
MAX_FORM_FIELD_SIZE_KB=16
MAX_CONCURRENT_JOBS=2

# Document and image safety limits
MAX_PDF_PAGES_PER_JOB=2000
MAX_IMAGE_PIXELS=40000000
MAX_TOTAL_IMAGE_PIXELS=100000000
MAX_OFFICE_ARCHIVE_ENTRIES=10000
MAX_OFFICE_UNCOMPRESSED_SIZE_MB=250
MAX_OFFICE_COMPRESSION_RATIO=200

# Conversion and cleanup behavior
CONVERSION_TIMEOUT_SECONDS=60
CLEANUP_MODE=immediate
CLEANUP_DELAY_MINUTES=10
LIBREOFFICE_PATH=libreoffice

# Exact browser origin allowed to call the API
CORS_ORIGIN=http://localhost:3000
